<?xml version="1.0" encoding="utf-8"?>
<!-- Dados financeiros não vão para a nuvem automaticamente: o backup é feito pelo próprio app, quando a pessoa quiser. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <!-- As permissões das pastas e nuvens do backup automático não passam para o celular novo: lá ele é escolhido de novo. -->
        <exclude domain="file" path="datastore/auto_backup.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
