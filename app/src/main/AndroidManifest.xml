<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- RF-VOZ-02: o microfone para o registro por voz. O áudio fica só na memória (nunca vira arquivo) e o app não tem internet. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- RF-AVI-10: o modo compras "ao vivo" (Android 16+). Permissão comum: não pergunta nada à pessoa e não tem relação com rede. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Android 11+: para achar o reconhecedor de voz do celular (plano B, só no aparelho). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".CryoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cryo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RF-WID (1.7, LA9): o widget na tela inicial e a tela de editar o widget (só escolhas de tela, nenhum dado). -->
        <receiver
            android:name=".ui.widget.CryoWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cryo_widget_info" />
        </receiver>
        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Cryo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- RF-AVI-03: os botões das notificações ("Já paguei", "Dia sem gastos"...). Só o próprio app chama. -->
        <receiver
            android:name=".notify.AlertActionReceiver"
            android:exported="false" />

        <!-- RF-AVI-09: entrega as figurinhas animadas para quem desenha a notificação, só com permissão dada a cada uma. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.stickers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sticker_paths" />
        </provider>
    </application>
</manifest>
